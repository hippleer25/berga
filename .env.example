# ── Server ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins with protocol prefix.
# The frontend strips the protocol for Vite allowedHosts; the backend uses as-is for CORS.
ALLOWED_ORIGINS=https://dev.berga.hippler.net.br,https://berga.hippler.net.br

# ── Database ──────────────────────────────────────────────────────────────────
DB_HOST=mysql
DB_USER=berga_user
DB_PASSWORD=your_password
DB_NAME=berga_db

# ── Authentication ────────────────────────────────────────────────────────────
SECRET_KEY=change_me_to_a_random_string

# ── Qdrant ────────────────────────────────────────────────────────────────────
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379

# ── Embedding / Vector store ──────────────────────────────────────────────────
EMBEDDING_MODEL_NAME=sentence-transformers/static-similarity-mrl-multilingual-v1
QDRANT_COLLECTION_NAME=feed_items
VECTOR_SIZE=256
DISTANCE_METRIC=Cosine

# Characters of article description to include in embedding (0 = title only, 200 = recommended)
# Changing this value requires running the reembed_all job to update existing vectors
EMBEDDING_DESCRIPTION_CHARS=200

# ── LLM for Clustering ────────────────────────────────────────────────────────
CLUSTER_LLM_MODEL=nvidia_nim/mistralai/mistral-nemotron
CLUSTER_LLM_API_KEY=your_api_key_here
CLUSTER_LLM_API_BASE=https://integrate.api.nvidia.com/v1

# ── LLM for Chatbot ───────────────────────────────────────────────────────────
CHATBOT_LLM_MODEL=nvidia_nim/mistralai/mistral-nemotron
CHATBOT_LLM_API_KEY=your_api_key_here
CHATBOT_LLM_API_BASE=https://integrate.api.nvidia.com/v1

# ── General LLM Settings ──────────────────────────────────────────────────────
LITELLM_VERBOSE=false
LLM_TIMEOUT=120

# ── Cookie Settings ───────────────────────────────────────────────────────────
COOKIE_MAX_AGE=604800
# Set to "true" when serving over HTTPS
COOKIE_SECURE=false

# ── Cache ─────────────────────────────────────────────────────────────────────
CACHE_KEY=weekly_events_cache
CACHE_TTL=21600
CACHE_FRESHNESS_SECONDS=1800

# ── Event Clustering ─────────────────────────────────────────────────────────
# Percentile of k-NN distances to use as DBSCAN eps (lower = tighter = more
# clusters; higher = looser = fewer). Cosine metric. Max eps cap at 0.35.
CLUSTER_EPS_PERCENTILE=15
# Minimum articles required to form a cluster
CLUSTER_MIN_CLUSTER_SIZE=3
# Minimum distinct feeds a cluster must have to be included
CLUSTER_MIN_UNIQUE_FEEDS=2
# Lookback window in days for fetching articles to cluster
CLUSTER_DAYS=7
# Maximum number of event clusters returned
CLUSTER_LIMIT=100

# ── Recommendation Cluster ────────────────────────────────────────────────────
FIND_SIMILAR=true
MERGE_SIMILAR=true
CLUSTER_BOOTS=1.1

# ── Ranking ───────────────────────────────────────────────────────────────────
NEGATIVE_PENALTY_FACTOR=0.3
PUBLISHER_BOOST_FACTOR=0.2
RECENCY_FACTOR=0.2
RECENCY_HALF_LIFE=7

# ── Feed Parsing ──────────────────────────────────────────────────────────────
FEED_PARSE_MAX_CONCURRENT=2
FEED_STALE_HOURS=6
FEED_REFRESH_CRON_HOURS=0,6,12,18
FEED_FETCH_TIMEOUT=15
FEED_PARSER_MAX_WORKERS=10

# ── Ranked Cache ──────────────────────────────────────────────────────────────
RANKING_CACHE_SIZE=500
RANKING_CACHE_TTL=300
