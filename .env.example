# ── Server ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins with protocol prefix.
# The frontend strips the protocol for Vite allowedHosts; the backend uses as-is for CORS.
ALLOWED_ORIGINS=https://dev.berga.hippler.net.br,https://berga.hippler.net.br

# ── Database ──────────────────────────────────────────────────────────────────
DB_HOST=mysql
DB_USER=berga_user
DB_PASSWORD=your_password
DB_NAME=berga_db

# ── Authentication ────────────────────────────────────────────────────────────
SECRET_KEY=change_me_to_a_random_string

# ── Qdrant ────────────────────────────────────────────────────────────────────
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379

# ── Embedding / Vector store ──────────────────────────────────────────────────
EMBEDDING_MODEL_NAME=sentence-transformers/static-similarity-mrl-multilingual-v1
QDRANT_COLLECTION_NAME=feed_items
VECTOR_SIZE=256
DISTANCE_METRIC=Cosine

# Characters of article description to include in embedding (0 = title only, 200 = recommended)
# Changing this value requires running the reembed_all job to update existing vectors
EMBEDDING_DESCRIPTION_CHARS=200

# ── LLM for Clustering ────────────────────────────────────────────────────────
CLUSTER_LLM_MODEL=nvidia_nim/mistralai/mistral-nemotron
CLUSTER_LLM_API_KEY=your_api_key_here
CLUSTER_LLM_API_BASE=https://integrate.api.nvidia.com/v1

# ── LLM for Chatbot ───────────────────────────────────────────────────────────
CHATBOT_LLM_MODEL=nvidia_nim/mistralai/mistral-nemotron
CHATBOT_LLM_API_KEY=your_api_key_here
CHATBOT_LLM_API_BASE=https://integrate.api.nvidia.com/v1

# ── Optional LLM tiers (fall back to CHATBOT_LLM_* if unset) ───────────────────
# ROUTING_LLM_*    — tool-decision / classification (use a cheap, fast model)
# SUMMARIZE_LLM_*  — article resume + cluster summaries (cheap model recommended)
# SYNTHESIS_LLM_*  — final chat answer synthesis (use a strong model)
#
# Example (cheap routing, strong synthesis):
# ROUTING_LLM_MODEL=deepseek-chat
# ROUTING_LLM_API_KEY=your_key
# SUMMARIZE_LLM_MODEL=deepseek-chat
# SUMMARIZE_LLM_API_KEY=your_key
# SYNTHESIS_LLM_MODEL=deepseek-reasoner
# SYNTHESIS_LLM_API_KEY=your_key

# ── General LLM Settings ──────────────────────────────────────────────────────
LITELLM_VERBOSE=false
LLM_TIMEOUT=120
# Max output tokens per synthesis segment for the final chat answer
# (default 2048). Long answers auto-continue in seamless segments until
# the model finishes — SYNTHESIS_MAX_CONTINUATIONS bounds the total.
SYNTHESIS_OUTPUT_TOKENS=2048
# Max seamless continuation segments when a synthesis hits its output cap
# (default 6). Each segment re-streams from exactly where it stopped, so
# answers end on complete sentences, never mid-word.
SYNTHESIS_MAX_CONTINUATIONS=6
# Max input tokens for the article context block in chat synthesis (default 6000).
# The budgeter truncates less-relevant articles to fit. Raise if your model
# has a large context window and you want more article depth.
SYNTHESIS_CONTEXT_TOKEN_BUDGET=6000

# ── Web fetch ladder (anti-bot fallback) ─────────────────────────────────────
# Article-page fetches escalate automatically: requests → curl_cffi
# (Chrome TLS impersonation, always on, no config needed) → Jina Reader.
# Jina is strictly opt-in:
#   off      → never contacted (default)
#   fallback → only when both HTTP tiers fail (403/Cloudflare/etc.)
#   always   → page text comes straight from Jina (skips local fetch)
# Without an API key Jina Reader is rate-limited to 20 requests/min;
# with a free key (jina.ai) it jumps to 500 RPM. Costs only output tokens.
JINA_READER_MODE=off
JINA_API_KEY=
JINA_TIMEOUT=20

# ── Cookie Settings ───────────────────────────────────────────────────────────
COOKIE_MAX_AGE=604800
# Set to "true" when serving over HTTPS
COOKIE_SECURE=false

# ── Cache ─────────────────────────────────────────────────────────────────────
CACHE_KEY=weekly_events_cache
CACHE_TTL=21600
CACHE_FRESHNESS_SECONDS=1800

# ── Event Clustering ─────────────────────────────────────────────────────────
# Percentile of k-NN distances to use as DBSCAN eps (lower = tighter = more
# clusters; higher = looser = fewer). Cosine metric. Max eps cap at 0.35.
CLUSTER_EPS_PERCENTILE=15
# Minimum articles required to form a cluster
CLUSTER_MIN_CLUSTER_SIZE=3
# Minimum distinct feeds a cluster must have to be included
CLUSTER_MIN_UNIQUE_FEEDS=2
# Lookback window in days for fetching articles to cluster
CLUSTER_DAYS=7
# Maximum number of event clusters returned
CLUSTER_LIMIT=100

# ── Recommendation Cluster ────────────────────────────────────────────────────
FIND_SIMILAR=true
MERGE_SIMILAR=true
CLUSTER_BOOTS=1.1

# ── Ranking ───────────────────────────────────────────────────────────────────
NEGATIVE_PENALTY_FACTOR=0.3
PUBLISHER_BOOST_FACTOR=0.2
RECENCY_FACTOR=0.2
RECENCY_HALF_LIFE=7

# ── Feed Parsing ──────────────────────────────────────────────────────────────
FEED_PARSE_MAX_CONCURRENT=2
FEED_STALE_HOURS=6
FEED_REFRESH_CRON_HOURS=0,6,12,18
FEED_FETCH_TIMEOUT=15
FEED_PARSER_MAX_WORKERS=10

# ── Ranked Cache ──────────────────────────────────────────────────────────────
RANKING_CACHE_SIZE=500
RANKING_CACHE_TTL=300
